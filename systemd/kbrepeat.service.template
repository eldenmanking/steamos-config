[Unit]
Description=Set keyboard repeat delay and rate when Steam Big Picture opens
# Runs for the whole user session and finds the X display itself (see
# bin/kbrepeat-watch), so it doesn't depend on graphical-session.target. With an
# encrypted home, home-units.service starts default.target once it's unlocked.

[Service]
EnvironmentFile=-%h/.config/kbrepeat/env
ExecStart=__REPO_DIR__/bin/kbrepeat-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
